# CivicForge Frontend Environment Configuration
# Set this to your live backend API URL in Netlify (or local backend for testing)
# In production on Netlify, configure VITE_API_URL in Netlify Site settings > Environment variables.
# Format: https://<your-backend-domain>/api (or http://localhost:5000/api for local testing)
VITE_API_URL=http://localhost:5000/api
